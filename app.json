{
  "expo": {
    "name": "Truco",
    "slug": "truco-anotador",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/truco-icon.png",
    "scheme": "truco",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/truco-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.l4uty.trucoanotador",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4A2817",
        "foregroundImage": "./assets/images/truco-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.l4uty.trucoanotador"
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/truco-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4A2817",
          "image": "./assets/images/truco-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permitir que Truco use la cámara para guardar un recuerdo de la partida.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/AnotadorTruco",
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d43ca616-760f-412c-921d-9405c0845889"
      }
    }
  }
}
